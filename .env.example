WHATSAPP_TOKEN=your_whatsapp_token_here
WHATSAPP_PHONE_ID=your_phone_number_id_here
WHATSAPP_APP_SECRET=your_app_secret_here
VERIFY_TOKEN=your_verify_token_here

# Path to your Excel product catalogue (.xlsx or .xls)
# Defaults to products.xlsx in the project root if omitted
PRODUCTS_FILE=products.xlsx

PORT=3000

# Odoo XML-RPC connection (Ticket 2 — live product sync)
# API key: Odoo Settings → Users → your user → Account Security → API Keys
ODOO_URL=https://your-odoo-instance.com
ODOO_DB=your-database-name
ODOO_USERNAME=your-user@email.com
ODOO_API_KEY=your-odoo-api-key
ODOO_FETCH_LIMIT=5000
